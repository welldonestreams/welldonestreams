window.GameAPI = {
  // Fetch balance from browser storage, default to 10,000 if new
  getBalance: async function() {
    let bal = localStorage.getItem('fakestake_balance');
    if (bal === null) {
      bal = 10000;
      localStorage.setItem('fakestake_balance', bal);
    }
    return parseInt(bal, 10);
  },

  // Save new balance and update the topbar UI
  setBalance: async function(newBal) {
    localStorage.setItem('fakestake_balance', newBal);
    const uiBalance = document.getElementById('global-balance');
    if (uiBalance) uiBalance.textContent = window.CasinoShared.formatAmt(newBal);
    return newBal;
  }
};

// Auto-load the money into the top bar when the page opens
document.addEventListener('DOMContentLoaded', async () => {
  const startingMoney = await window.GameAPI.getBalance();
  const uiBalance = document.getElementById('global-balance');
  if (uiBalance) uiBalance.textContent = window.CasinoShared ? window.CasinoShared.formatAmt(startingMoney) : startingMoney;
});

// Daily Claim Button Logic
document.addEventListener('DOMContentLoaded', () => {
  const claimBtn = document.getElementById('dailyClaimBtn');
  if (claimBtn) {
    claimBtn.onclick = async () => {
      let current = await window.GameAPI.getBalance();
      await window.GameAPI.setBalance(current + 1000);
      alert("Claimed 1,000 daily chips!");
    };
  }
});
